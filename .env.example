# קובץ דוגמה למשתני סביבה - מעתיקים ל-.env ומשנים ערכים לפי הצורך:  cp .env.example .env
# הפורט במחשב המארח שדרכו נכנסים ללוח הבקרה (ממופה לפורט 80 של קונטיינר ה-web)
WEB_PORT=8080
# מספר המקומות המקסימלי בחניון
PARKING_CAPACITY=10
# מחיר השעה הראשונה בשקלים
PRICE_FIRST_HOUR=12
# מחיר כל שעה נוספת שהתחילה, בשקלים
PRICE_EXTRA_HOUR=8
# מספר הדקות הראשונות שבהן החניה בחינם
FREE_MINUTES=15
