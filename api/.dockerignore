# קבצים שלא נשלחים ל-Docker בזמן build (מקטין את ה-context ומונע דליפת סודות)
# התלויות המקומיות - בתוך האימג' מתקינים אותן מחדש עם npm ci
node_modules/
# לוג שגיאות של npm
npm-debug.log
# קובץ סודות - אסור שייכנס לאימג'
.env
# ה-Dockerfile עצמו לא נדרש בתוך האימג'
Dockerfile
# גם הקובץ הזה לא נדרש בתוך האימג'
.dockerignore
